title: "Λ-EG — Emergent Gravitational Coherence: Theory, Ontology, Cosmology (T.O.C.)"
authors:
  - family-names: "Figueroa Torres"
    given-names: "J. Pablo"
    orcid: "https://orcid.org/0009-0005-5297-8777"
